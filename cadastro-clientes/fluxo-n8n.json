    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"></head><body><title>Fun Festival Homegame</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..900&family=Red+Hat+Text:wght@400;500;600;700&display=swap\">\n<style>\n/* Layout: faixa roxa em cima e preto embaixo (como a referência), fichas de poker no lugar dos círculos, cartão escuro central com 3 etapas. Marca H2 só no escuro, por decisão. */\n:root{\n  color-scheme:dark;\n  --ground:#0A070C;         /* preto da metade de baixo */\n  --band:#2A0B33;           /* faixa roxa de cima */\n  --sheet:#141017;          /* cartão do formulário */\n  --field:#1E1823;          /* campos */\n  --field-hover:#251D2B;\n  --line:#33283A;\n  --ink:#F4F0F6;\n  --ink-2:#BDB3C4;\n  --ink-3:#8A7F92;\n  --plum:#77158E;           /* roxo H2: filete, bloco, borda */\n  --plum-deep:#4C0D5A;\n  --orchid:#C05CD6;         /* roxo H2 em texto de destaque */\n  --mint:#24CFA4;           /* verde H2: só botão */\n  --mint-ink:#06251C;\n  --danger:#FF7A85;\n  --display:\"Archivo\",\"Arial Black\",Impact,sans-serif;\n  --body:\"Red Hat Text\",system-ui,-apple-system,\"Segoe UI\",sans-serif;\n  --r-field:12px;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nhtml,body{min-height:100%}\nbody{\n  margin:0;background:var(--ground);color:var(--ink);\n  font-family:var(--body);font-size:15px;line-height:1.5;\n  -webkit-font-smoothing:antialiased;overflow-x:hidden;\n}\n.stage{\n  position:relative;isolation:isolate;\n  padding-block:56px 72px;\n  padding-left:max(16px,env(safe-area-inset-left,0px));\n  padding-right:max(16px,env(safe-area-inset-right,0px));\n  background:linear-gradient(to bottom,var(--band) 0,var(--band) 46%,var(--ground) 46%);\n  min-height:100vh;overflow:hidden;\n}\n/* fichas de poker decorativas */\n.chip{\n  position:absolute;z-index:-1;border-radius:50%;pointer-events:none;\n  background:\n    radial-gradient(circle,var(--c) 0 46%,transparent 46.5%),\n    radial-gradient(circle,transparent 0 58%,var(--c) 58.5% 60%,transparent 60.5%),\n    repeating-conic-gradient(var(--c) 0 15deg,#F4F0F6 15deg 30deg);\n  -webkit-mask:radial-gradient(circle,#000 70%,transparent 70.5%);\n          mask:radial-gradient(circle,#000 70%,transparent 70.5%);\n  opacity:.9;\n}\n.chip::after{\n  content:\"H2\";position:absolute;inset:0;display:grid;place-items:center;\n  font:900 calc(var(--s)*.17)/1 var(--display);font-stretch:125%;color:#F4F0F6;opacity:.85;\n}\n.chip.a{--c:var(--plum);--s:240px;width:var(--s);height:var(--s);top:-70px;left:calc(50% - 120px);transform:rotate(8deg)}\n.chip.b{--c:var(--plum-deep);--s:150px;width:var(--s);height:var(--s);top:38%;left:-60px;transform:rotate(-14deg)}\n.chip.c{--c:var(--plum);--s:130px;width:var(--s);height:var(--s);top:40%;right:-30px;transform:rotate(20deg)}\n.chip.d{--c:var(--plum-deep);--s:220px;width:var(--s);height:var(--s);bottom:40px;left:4%;transform:rotate(-4deg);opacity:.55}\n.chip.e{--c:var(--plum);--s:96px;width:var(--s);height:var(--s);bottom:24px;right:6%;transform:rotate(30deg);opacity:.7}\n\n.card{\n  position:relative;max-width:760px;margin:0 auto;\n  background:var(--sheet);border:1px solid var(--line);border-radius:22px;\n  box-shadow:0 30px 80px -30px rgba(0,0,0,.8),0 0 0 1px rgba(119,21,142,.25);\n  padding:28px clamp(18px,5vw,56px) 36px;\n}\n.topline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--ink-3)}\n.brand{display:flex;align-items:center;gap:10px;color:var(--ink-2);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:11px}\n.brand b{font:900 20px/1 var(--display);font-stretch:125%;color:var(--ink);letter-spacing:0}\n.topline a{color:var(--orchid);font-weight:700;text-decoration:none}\n.topline a:hover{text-decoration:underline}\nh1{\n  margin:22px 0 4px;text-align:center;text-wrap:balance;\n  font:900 clamp(26px,5vw,38px)/1.02 var(--display);font-stretch:125%;text-transform:uppercase;letter-spacing:-.01em;\n}\nh1 em{font-style:normal;color:var(--orchid)}\n.lede{margin:0 auto;text-align:center;color:var(--ink-2);max-width:60ch;display:grid;gap:10px}\n.lede p{margin:0;text-wrap:pretty}\n.lede b{color:var(--ink)}\n.lede .lede-lead{font:800 clamp(16px,2.6vw,19px)/1.3 var(--display);font-stretch:112%;color:var(--orchid)}\n\n/* etapas */\n.steps{list-style:none;margin:26px auto 30px;padding:0;display:grid;grid-template-columns:repeat(3,1fr);max-width:520px;position:relative}\n.steps li{display:grid;justify-items:center;gap:6px;font-size:12px;color:var(--ink-3);font-weight:600;position:relative;text-align:center}\n.steps li::before{\n  content:\"\";position:absolute;top:13px;right:50%;width:100%;height:2px;background:var(--line);z-index:0;\n}\n.steps li:first-child::before{display:none}\n.steps li.done::before,.steps li.on::before{background:var(--plum)}\n.dot{\n  position:relative;z-index:1;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;\n  background:var(--field);border:2px solid var(--line);color:var(--ink-3);font:800 12px/1 var(--display);\n}\n.steps li.on{color:var(--ink)}\n.steps li.on .dot{background:var(--plum);border-color:var(--orchid);color:#fff;box-shadow:0 0 0 5px rgba(192,92,214,.18)}\n.steps li.done .dot{background:var(--plum-deep);border-color:var(--plum);color:var(--orchid)}\n\n/* seções */\n.pane{display:grid;gap:22px}\n.pane-head{display:flex;justify-content:space-between;align-items:center;gap:20px}\n.pane-head h2{margin:0;font:800 17px/1.2 var(--display);font-stretch:112%;text-transform:uppercase;letter-spacing:.02em}\n.pane-head p{margin:4px 0 0;color:var(--ink-3);font-size:13px}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 20px}\n.full{grid-column:1/-1}\n.field{display:grid;gap:7px;min-width:0;align-content:start}\n.field>label,.legend{font-size:12.5px;font-weight:700;color:var(--ink-2)}\n.req{color:var(--orchid)}\n.opt{color:var(--ink-3);font-weight:500}\ntextarea{\n  width:100%;min-height:130px;padding:14px 16px;border-radius:var(--r-field);resize:vertical;\n  background:var(--field);border:1.5px solid transparent;color:var(--ink);font:500 14.5px/1.5 var(--body);\n}\ntextarea:hover{background-color:var(--field-hover)}\ntextarea:focus{outline:none;border-color:var(--orchid);background-color:var(--field-hover)}\n.field.bad textarea{border-color:var(--danger)}\n.grid.three{grid-template-columns:repeat(3,1fr)}\n.field.sub{padding-left:18px;border-left:2px solid var(--plum)}\n.field.big>label{font:800 15px/1.3 var(--display);font-stretch:112%;color:var(--ink);text-transform:uppercase;letter-spacing:.01em}\ninput[type=text],input[type=email],input[type=tel],input[type=date],select{\n  width:100%;height:46px;padding:0 16px;border-radius:var(--r-field);\n  background:var(--field);border:1.5px solid transparent;color:var(--ink);\n  font:500 14.5px/1 var(--body);transition:border-color .15s,background .15s;\n  appearance:none;-webkit-appearance:none;\n}\nselect{\n  background-image:linear-gradient(45deg,transparent 50%,var(--ink-2) 50%),linear-gradient(135deg,var(--ink-2) 50%,transparent 50%);\n  background-position:calc(100% - 20px) 50%,calc(100% - 15px) 50%;background-size:5px 5px;background-repeat:no-repeat;padding-right:40px;\n}\ninput::placeholder{color:var(--ink-3)}\nselect option{background:var(--field);color:var(--ink)}\ninput:hover,select:hover{background-color:var(--field-hover)}\ninput:focus,select:focus{outline:none;border-color:var(--orchid);background-color:var(--field-hover)}\ninput[type=date]::-webkit-calendar-picker-indicator{filter:invert(.7)}\n.field.bad input,.field.bad select{border-color:var(--danger)}\n.err{min-height:0;font-size:12px;color:var(--danger);font-weight:600}\n.err:empty{display:none}\n.hint{font-size:12px;color:var(--ink-3)}\n\n/* ficha com iniciais (no lugar do \"Add photo\") */\n.who{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}\n.token{display:grid;justify-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--ink-2)}\n.token .chipface{\n  --c:var(--plum);width:92px;height:92px;border-radius:50%;position:relative;display:grid;place-items:center;\n  background:\n    radial-gradient(circle,var(--c) 0 52%,transparent 52.5%),\n    repeating-conic-gradient(var(--c) 0 15deg,#F4F0F6 15deg 30deg);\n  box-shadow:0 10px 30px -8px rgba(192,92,214,.55);\n}\n.token .chipface span{font:900 24px/1 var(--display);font-stretch:125%;color:#fff;letter-spacing:.02em}\n\n/* opções em pílula */\n.pills{display:flex;flex-wrap:wrap;gap:10px}\n.pill{position:relative}\n.pill input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}\n.pill span{\n  display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border-radius:999px;\n  background:var(--field);border:1.5px solid var(--line);color:var(--ink-2);font-weight:600;font-size:13.5px;cursor:pointer;\n  transition:border-color .15s,background .15s,color .15s;\n}\n.pill span::before{\n  content:\"\";width:16px;height:16px;border-radius:50%;border:1.5px solid var(--ink-3);flex:none;\n}\n.pill input[type=checkbox]+span::before{border-radius:5px}\n.pill input:checked+span{background:rgba(119,21,142,.28);border-color:var(--orchid);color:var(--ink)}\n.pill input:checked+span::before{background:var(--orchid);border-color:var(--orchid);box-shadow:inset 0 0 0 3px var(--sheet)}\n.pill input:focus-visible+span{outline:2px solid var(--orchid);outline-offset:2px}\n\n/* consentimento */\n.consent{display:grid;gap:12px;padding:18px;border-radius:14px;background:var(--field);border:1px solid var(--line)}\n.check{display:grid;grid-template-columns:20px 1fr;gap:12px;align-items:start;font-size:13.5px;color:var(--ink-2);cursor:pointer}\n.check input{width:20px;height:20px;margin:1px 0 0;accent-color:var(--plum);cursor:pointer}\n.check a{color:var(--orchid)}\n\n/* resumo da etapa 3 */\n.review{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--line);border-radius:14px;overflow:hidden}\n.review div{padding:12px 16px;border-bottom:1px solid var(--line);min-width:0}\n.review dt{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3);font-weight:700}\n.review dd{margin:2px 0 0;font-weight:600;overflow-wrap:anywhere}\n.edit{background:none;border:0;color:var(--orchid);font:700 13px var(--body);cursor:pointer;padding:6px 0}\n.edit:hover{text-decoration:underline}\n\n/* botões */\n.actions{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:30px;flex-wrap:wrap}\n.btn{\n  height:48px;padding:0 30px;border-radius:999px;border:0;cursor:pointer;\n  font:800 14px/1 var(--display);font-stretch:112%;text-transform:uppercase;letter-spacing:.04em;\n}\n.btn.go{background:var(--mint);color:var(--mint-ink);box-shadow:0 12px 30px -10px rgba(36,207,164,.6)}\n.btn.go:hover{filter:brightness(1.07)}\n.btn.go:disabled{opacity:.6;cursor:progress}\n.btn.back{background:transparent;color:var(--ink-2);border:1.5px solid var(--line)}\n.btn.back:hover{border-color:var(--ink-3);color:var(--ink)}\n.btn:focus-visible,.edit:focus-visible{outline:2px solid var(--orchid);outline-offset:3px}\n.formerr{text-align:center;color:var(--danger);font-weight:600;font-size:13px;margin:16px 0 0}\n.formerr:empty{display:none}\n\n/* sucesso */\n.done-view{text-align:center;display:grid;justify-items:center;gap:14px;padding:12px 0 6px}\n.done-view .chipface{width:120px;height:120px}\n.done-view .chipface span{font-size:30px}\n.done-view h2{margin:6px 0 0;font:900 clamp(24px,4.5vw,32px)/1.05 var(--display);font-stretch:125%;text-transform:uppercase;text-wrap:balance}\n.done-view h2 em{font-style:normal;color:var(--orchid)}\n.done-view p{margin:0;color:var(--ink-2);max-width:48ch}\n.tag{font:800 13px/1 var(--display);font-stretch:125%;color:var(--orchid);letter-spacing:.04em}\n\n/* aviso de protótipo */\n.note{max-width:760px;margin:18px auto 0;font-size:12.5px;color:var(--ink-3);text-align:center}\n\n\n@media (max-width:640px){\n  .grid,.grid.three{grid-template-columns:1fr}\n  .who{grid-template-columns:1fr;justify-items:stretch}\n  .token{order:-1}\n  .review{grid-template-columns:1fr 1fr}\n  .chip.a{--s:170px;top:-60px;left:calc(50% - 85px)}\n  .chip.b,.chip.c,.chip.e{display:none}\n  .pane-head{flex-wrap:wrap}\n}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n</style>\n\n<main class=\"stage\">\n  <div class=\"chip a\" aria-hidden=\"true\"></div>\n  <div class=\"chip b\" aria-hidden=\"true\"></div>\n  <div class=\"chip c\" aria-hidden=\"true\"></div>\n  <div class=\"chip d\" aria-hidden=\"true\"></div>\n  <div class=\"chip e\" aria-hidden=\"true\"></div>\n\n  <section class=\"card\" aria-labelledby=\"titulo\">\n    <div class=\"topline\">\n      <span class=\"brand\"><b>H2</b> Sports Bar</span>\n    </div>\n\n    <h1 id=\"titulo\">Fun Festival no seu <em>homegame</em></h1>\n    <div class=\"lede\" id=\"lede\">\n      <p class=\"lede-lead\">Seu homegame no Main Event do Fun Festival!</p>\n      <p>Vamos selecionar <b>20 homegames</b> para ganhar <b>1 buy‑in (R$&nbsp;450)</b> do Main Event. 🎉</p>\n      <p>Cada grupo selecionado ganha uma vaga e escolhe quem vai representar a mesa. O buy‑in vale apenas para o Dia 1, e o jogador pode escolher qual Dia 1 prefere jogar.</p>\n      <p>Para participar: conte no formulário o nome do grupo, a cidade, quantas pessoas jogam, com que frequência e por que vocês merecem estar no Fun Festival!</p>\n    </div>\n\n    <ol class=\"steps\" id=\"steps\">\n      <li class=\"on\"><span class=\"dot\">1</span>Dados pessoais</li>\n      <li><span class=\"dot\">2</span>Contato</li>\n      <li><span class=\"dot\">3</span>O homegame</li>\n    </ol>\n\n    <form id=\"form\" novalidate>\n      <!-- ETAPA 1 -->\n      <div class=\"pane\" data-step=\"1\">\n        <div class=\"pane-head\"><div><h2>Dados pessoais</h2><p>Campos com <span class=\"req\">*</span> são obrigatórios.</p></div></div>\n        <div class=\"who\">\n          <div class=\"grid\">\n            <div class=\"field full\">\n              <label for=\"nome\">Nome completo <span class=\"req\">*</span></label>\n              <input type=\"text\" id=\"nome\" name=\"nome\" autocomplete=\"name\" placeholder=\"Como está no seu documento\">\n              <span class=\"err\"></span>\n            </div>\n            <div class=\"field full\">\n              <label for=\"nascimento\">Data de nascimento <span class=\"req\">*</span></label>\n              <input type=\"date\" id=\"nascimento\" name=\"nascimento\" autocomplete=\"bday\">\n              <span class=\"err\"></span>\n            </div>\n          </div>\n          <div class=\"token\" aria-hidden=\"true\">\n            <div class=\"chipface\"><span id=\"iniciais\">H2</span></div>\n            Sua ficha\n          </div>\n        </div>\n        <div class=\"grid\">\n          <div class=\"field full\">\n            <span class=\"legend\" id=\"lg-genero\">Gênero <span class=\"opt\">(opcional)</span></span>\n            <div class=\"pills\" role=\"radiogroup\" aria-labelledby=\"lg-genero\">\n              <label class=\"pill\"><input type=\"radio\" name=\"genero\" id=\"g-f\" value=\"Feminino\"><span>Feminino</span></label>\n              <label class=\"pill\"><input type=\"radio\" name=\"genero\" id=\"g-m\" value=\"Masculino\"><span>Masculino</span></label>\n              <label class=\"pill\"><input type=\"radio\" name=\"genero\" id=\"g-o\" value=\"Outro\"><span>Outro</span></label>\n              <label class=\"pill\"><input type=\"radio\" name=\"genero\" id=\"g-n\" value=\"Prefiro não informar\"><span>Prefiro não informar</span></label>\n            </div>\n          </div>\n          <div class=\"field\">\n            <label for=\"homegame\">Nome do homegame <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"homegame\" name=\"homegame\" placeholder=\"Ex.: Poker de Quinta\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"instagram\">@ do seu homegame <span class=\"opt\">(opcional)</span></label>\n            <input type=\"text\" id=\"instagram\" name=\"instagram\" autocapitalize=\"none\" spellcheck=\"false\" placeholder=\"@pokerdequinta\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field full\">\n            <label for=\"representante\">Nome do representante <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"representante\" name=\"representante\" placeholder=\"Quem vai jogar o Main Event pela mesa\">\n            <span class=\"hint\">Pode ser você ou outra pessoa do grupo.</span>\n            <span class=\"err\"></span>\n          </div>\n        </div>\n      </div>\n\n      <!-- ETAPA 2 -->\n      <div class=\"pane\" data-step=\"2\" hidden>\n        <div class=\"pane-head\"><div><h2>Contato</h2><p>É pelo e-mail do representante que a H2 vai falar com o seu homegame.</p></div></div>\n        <div class=\"grid\">\n          <div class=\"field\">\n            <label for=\"email\">E-mail do representante <span class=\"req\">*</span></label>\n            <input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"representante@email.com\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"celular\">Celular / WhatsApp <span class=\"req\">*</span></label>\n            <input type=\"tel\" id=\"celular\" name=\"celular\" autocomplete=\"tel-national\" inputmode=\"numeric\" placeholder=\"(11) 90000-0000\" maxlength=\"15\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field full\">\n            <label for=\"endereco\">Endereço do homegame <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"endereco\" name=\"endereco\" autocomplete=\"street-address\" placeholder=\"Rua, número e bairro\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"cep\">CEP <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"cep\" name=\"cep\" autocomplete=\"postal-code\" inputmode=\"numeric\" placeholder=\"00000-000\" maxlength=\"9\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"cidade\">Cidade <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"cidade\" name=\"cidade\" autocomplete=\"address-level2\" placeholder=\"São Paulo\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"uf\">Estado <span class=\"req\">*</span></label>\n            <select id=\"uf\" name=\"uf\" autocomplete=\"address-level1\"><option value=\"\">Selecione</option></select>\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"origem\">Como conheceu a H2? <span class=\"opt\">(opcional)</span></label>\n            <select id=\"origem\" name=\"origem\">\n              <option value=\"\">Selecione</option>\n              <option>Instagram</option>\n              <option>Indicação de amigo</option>\n              <option>Google</option>\n              <option>Torneio ou evento</option>\n              <option>Já frequento o clube</option>\n              <option>Outro</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- ETAPA 3 -->\n      <div class=\"pane\" data-step=\"3\" hidden>\n        <div class=\"pane-head\"><div><h2>O homegame</h2><p>Conte como é a mesa de vocês.</p></div></div>\n        <div class=\"field\">\n          <span class=\"legend\" id=\"lg-dias\">Em que dia acontece o seu homegame? <span class=\"req\">*</span></span>\n          <div class=\"pills\" role=\"group\" aria-labelledby=\"lg-dias\">\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-seg\" value=\"Segunda\"><span>Segunda</span></label>\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-ter\" value=\"Terça\"><span>Terça</span></label>\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-qua\" value=\"Quarta\"><span>Quarta</span></label>\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-qui\" value=\"Quinta\"><span>Quinta</span></label>\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-sex\" value=\"Sexta\"><span>Sexta</span></label>\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-sab\" value=\"Sábado\"><span>Sábado</span></label>\n            <label class=\"pill\"><input type=\"checkbox\" name=\"dias\" id=\"d-dom\" value=\"Domingo\"><span>Domingo</span></label>\n          </div>\n          <span class=\"err\" id=\"err-dias\"></span>\n        </div>\n        <div class=\"field sub\">\n          <span class=\"legend\" id=\"lg-freq\">Com que frequência? <span class=\"req\">*</span></span>\n          <div class=\"pills\" role=\"radiogroup\" aria-labelledby=\"lg-freq\">\n            <label class=\"pill\"><input type=\"radio\" name=\"frequencia\" id=\"f-1\" value=\"1x por semana\"><span>1x por semana</span></label>\n            <label class=\"pill\"><input type=\"radio\" name=\"frequencia\" id=\"f-2\" value=\"2x por semana\"><span>2x por semana</span></label>\n            <label class=\"pill\"><input type=\"radio\" name=\"frequencia\" id=\"f-3\" value=\"3x ou mais por semana\"><span>3x ou mais por semana</span></label>\n            <label class=\"pill\"><input type=\"radio\" name=\"frequencia\" id=\"f-15\" value=\"A cada 15 dias\"><span>A cada 15 dias</span></label>\n            <label class=\"pill\"><input type=\"radio\" name=\"frequencia\" id=\"f-m\" value=\"1x por mês\"><span>1x por mês</span></label>\n          </div>\n          <span class=\"err\" id=\"err-freq\"></span>\n        </div>\n        <div class=\"grid three\">\n          <div class=\"field\">\n            <label for=\"buyin\">Valor do buy-in <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"buyin\" name=\"buyin\" inputmode=\"numeric\" placeholder=\"R$ 100\">\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"arrecadacao\">Arrecadação estimada <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"arrecadacao\" name=\"arrecadacao\" inputmode=\"numeric\" placeholder=\"R$ 1.000\">\n            <span class=\"hint\">Total de uma noite de jogo.</span>\n            <span class=\"err\"></span>\n          </div>\n          <div class=\"field\">\n            <label for=\"jogadores\">Quantidade de jogadores <span class=\"req\">*</span></label>\n            <input type=\"text\" id=\"jogadores\" name=\"jogadores\" inputmode=\"numeric\" maxlength=\"3\" placeholder=\"Ex.: 9\">\n            <span class=\"err\"></span>\n          </div>\n        </div>\n\n        <div class=\"field big\">\n          <label for=\"motivo\">Por que o seu homegame tem que ganhar o buy-in do Main Event do Fun Festival? <span class=\"req\">*</span></label>\n          <textarea id=\"motivo\" name=\"motivo\" rows=\"5\" maxlength=\"1000\" placeholder=\"Conte a história da mesa, as rivalidades, quem é o tubarão do grupo…\"></textarea>\n          <span class=\"hint\" id=\"motivoConta\">0 / 1000</span>\n          <span class=\"err\"></span>\n        </div>\n\n        <div>\n          <div class=\"pane-head\" style=\"margin-bottom:12px\"><h2 style=\"font-size:14px\">Confira seus dados</h2></div>\n          <dl class=\"review\" id=\"review\"></dl>\n        </div>\n\n        <div class=\"consent\">\n          <label class=\"check\"><input type=\"checkbox\" id=\"optin\" name=\"optin\"><span>Quero receber e-mails da H2 com agenda, promoções e novidades. Posso cancelar quando quiser pelo link no fim de cada e-mail. <span class=\"req\">*</span></span></label>\n          <label class=\"check\"><input type=\"checkbox\" id=\"termos\" name=\"termos\"><span>Tenho 18 anos ou mais e concordo com a <a href=\"#\" id=\"linkPolitica\">Política de Privacidade</a> da H2. <span class=\"req\">*</span></span></label>\n          <span class=\"err\" id=\"err-consent\"></span>\n        </div>\n      </div>\n\n      <p class=\"formerr\" id=\"formerr\" role=\"alert\"></p>\n\n      <div class=\"actions\" id=\"actions\">\n        <button type=\"button\" class=\"btn back\" id=\"voltar\" hidden>Voltar</button>\n        <button type=\"submit\" class=\"btn go\" id=\"avancar\">Continuar</button>\n      </div>\n    </form>\n\n    <!-- SUCESSO -->\n    <div class=\"done-view\" id=\"sucesso\" hidden>\n      <div class=\"token\"><div class=\"chipface\"><span id=\"iniciais2\">H2</span></div></div>\n      <h2><em id=\"hgOk\">Seu homegame</em> está na disputa!</h2>\n      <p>Inscrição recebida. Fique de olho em <b id=\"emailOk\"></b>: é por lá que a H2 vai falar com o representante da mesa.</p>\n      <span class=\"tag\">#TOCAEJOGA</span>\n      <button type=\"button\" class=\"btn back\" id=\"novo\">Inscrever outro homegame</button>\n    </div>\n  </section>\n\n  <p class=\"note\" id=\"nota\" hidden>Modo de teste: a planilha ainda não está ligada, então as inscrições feitas aqui não são guardadas.</p>\n</main>\n\n<script>\n/* Endereço que recebe a inscrição: o Webhook do n8n (o gerar-fluxo-n8n.py preenche\n   sozinho) ou o \"App da Web\" do Google Apps Script (ver apps-script.gs).\n   Vazio = modo de teste: mostra a tela de sucesso, mas não guarda nada. */\nconst WEBHOOK_URL = (location.pathname.includes(\"/webhook-test/\") ? \"/webhook-test/\" : \"/webhook/\") + \"cadastro-h2-enviar\";\n\nconst UFS = [\"AC\",\"AL\",\"AP\",\"AM\",\"BA\",\"CE\",\"DF\",\"ES\",\"GO\",\"MA\",\"MT\",\"MS\",\"MG\",\"PA\",\"PB\",\"PR\",\"PE\",\"PI\",\"RJ\",\"RN\",\"RS\",\"RO\",\"RR\",\"SC\",\"SP\",\"SE\",\"TO\"];\nconst $ = s => document.querySelector(s);\nconst form = $(\"#form\");\nlet etapa = 1;\n\n/* SP primeiro (a maior parte dos inscritos), depois os outros em ordem alfabética */\n[\"SP\", \"—\", ...UFS.filter(u => u !== \"SP\")].forEach(u => {\n  const o = document.createElement(\"option\");\n  if (u === \"—\"){ o.disabled = true; o.textContent = \"──────────\"; }\n  else { o.value = u; o.textContent = u; }\n  $(\"#uf\").append(o);\n});\n$(\"#nota\").hidden = !!WEBHOOK_URL;\n\n/* ---------- máscaras ---------- */\nconst so = v => String(v).replace(/\\D/g, \"\");\nfunction mascaraCel(v){ v = so(v).slice(0,11); if (v.length <= 2) return v.length ? \"(\" + v : \"\"; if (v.length <= 6) return `(${v.slice(0,2)}) ${v.slice(2)}`; if (v.length <= 10) return `(${v.slice(0,2)}) ${v.slice(2,6)}-${v.slice(6)}`; return `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`; }\nfunction mascaraCep(v){ v = so(v).slice(0,8); return v.length > 5 ? v.slice(0,5) + \"-\" + v.slice(5) : v; }\nfunction mascaraReais(v){ v = so(v).replace(/^0+/, \"\").slice(0,9); return v ? \"R$ \" + Number(v).toLocaleString(\"pt-BR\") : \"\"; }\nfunction arroba(v){ v = v.trim().replace(/^https?:\\/\\/(www\\.)?instagram\\.com\\//i, \"\").replace(/[/?].*$/, \"\").replace(/^@+/, \"\").replace(/\\s+/g, \"\"); return v ? \"@\" + v : \"\"; }\n$(\"#celular\").addEventListener(\"input\", e => e.target.value = mascaraCel(e.target.value));\n$(\"#cep\").addEventListener(\"input\", e => e.target.value = mascaraCep(e.target.value));\n[\"#buyin\",\"#arrecadacao\"].forEach(s => $(s).addEventListener(\"input\", e => e.target.value = mascaraReais(e.target.value)));\n$(\"#jogadores\").addEventListener(\"input\", e => e.target.value = so(e.target.value).slice(0,3));\n$(\"#instagram\").addEventListener(\"blur\", e => e.target.value = arroba(e.target.value));\n$(\"#motivo\").addEventListener(\"input\", e => { $(\"#motivoConta\").textContent = `${e.target.value.length} / 1000`; });\n\n/* ---------- ficha com iniciais ---------- */\nfunction iniciais(texto){\n  const partes = (texto ?? $(\"#nome\").value).trim().split(/\\s+/).filter(Boolean);\n  if (!partes.length) return \"H2\";\n  const ini = partes.length === 1 ? partes[0].slice(0,2) : partes[0][0] + partes[partes.length-1][0];\n  return ini.toUpperCase();\n}\n$(\"#nome\").addEventListener(\"input\", () => { $(\"#iniciais\").textContent = iniciais(); });\n\n/* ---------- validação ---------- */\nfunction idade(iso){\n  const n = new Date(iso + \"T12:00:00\"); if (isNaN(n)) return -1;\n  const h = new Date(); let a = h.getFullYear() - n.getFullYear();\n  const m = h.getMonth() - n.getMonth(); if (m < 0 || (m === 0 && h.getDate() < n.getDate())) a--; return a;\n}\nfunction marca(id, msg){\n  const f = $(\"#\" + id).closest(\".field\"); const e = f.querySelector(\".err\");\n  f.classList.toggle(\"bad\", !!msg); if (e) e.textContent = msg || \"\";\n  $(\"#\" + id).setAttribute(\"aria-invalid\", msg ? \"true\" : \"false\");\n  return !msg;\n}\nfunction grupo(nome, errId, msg){\n  const ok = form.querySelectorAll(`input[name=\"${nome}\"]:checked`).length > 0;\n  $(\"#\" + errId).textContent = ok ? \"\" : msg;\n  return ok;\n}\nfunction valida(n){\n  const v = id => $(\"#\" + id).value.trim();\n  const ok = [];\n  if (n === 1){\n    const nome = v(\"nome\");\n    ok.push(marca(\"nome\", !nome ? \"Escreva seu nome completo.\" : nome.split(/\\s+/).length < 2 ? \"Escreva nome e sobrenome.\" : \"\"));\n    const i = v(\"nascimento\") ? idade(v(\"nascimento\")) : null;\n    ok.push(marca(\"nascimento\", i === null ? \"Informe sua data de nascimento.\" : i < 0 || i > 110 ? \"Revise a data.\" : i < 18 ? \"A inscrição é só para maiores de 18 anos.\" : \"\"));\n    ok.push(marca(\"homegame\", !v(\"homegame\") ? \"Diga o nome do seu homegame.\" : \"\"));\n    const ig = arroba(v(\"instagram\"));\n    ok.push(marca(\"instagram\", ig && !/^@[A-Za-z0-9._]{1,30}$/.test(ig) ? \"Use só letras, números, ponto e _, ex.: @pokerdequinta.\" : \"\"));\n    ok.push(marca(\"representante\", !v(\"representante\") ? \"Diga quem vai representar a mesa.\" : \"\"));\n  }\n  if (n === 2){\n    ok.push(marca(\"email\", !v(\"email\") ? \"Informe o e-mail do representante.\" : !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(v(\"email\")) ? \"Esse e-mail parece incompleto. Confira o @ e o domínio.\" : \"\"));\n    const cel = so(v(\"celular\"));\n    ok.push(marca(\"celular\", !cel ? \"Informe um celular.\" : cel.length !== 11 ? \"Use DDD + 9 dígitos, ex.: (11) 91234-5678.\" : \"\"));\n    ok.push(marca(\"endereco\", !v(\"endereco\") ? \"Informe o endereço do homegame.\" : \"\"));\n    ok.push(marca(\"cep\", !v(\"cep\") ? \"Informe o CEP.\" : so(v(\"cep\")).length !== 8 ? \"O CEP tem 8 números.\" : \"\"));\n    ok.push(marca(\"cidade\", !v(\"cidade\") ? \"Informe a cidade.\" : \"\"));\n    ok.push(marca(\"uf\", !v(\"uf\") ? \"Escolha o estado.\" : \"\"));\n  }\n  if (n === 3){\n    ok.push(grupo(\"dias\", \"err-dias\", \"Escolha pelo menos um dia.\"));\n    ok.push(grupo(\"frequencia\", \"err-freq\", \"Escolha a frequência.\"));\n    ok.push(marca(\"buyin\", !so(v(\"buyin\")) ? \"Informe o valor do buy-in.\" : \"\"));\n    ok.push(marca(\"arrecadacao\", !so(v(\"arrecadacao\")) ? \"Informe a arrecadação estimada.\" : \"\"));\n    const j = Number(so(v(\"jogadores\")));\n    ok.push(marca(\"jogadores\", !j ? \"Informe quantas pessoas jogam.\" : j < 2 ? \"Um homegame tem pelo menos 2 jogadores.\" : \"\"));\n    ok.push(marca(\"motivo\", v(\"motivo\").length < 20 ? \"Conte um pouco mais: por que vocês merecem a vaga?\" : \"\"));\n    const cons = $(\"#optin\").checked && $(\"#termos\").checked;\n    $(\"#err-consent\").textContent = cons ? \"\" : \"Marque as duas caixas para concluir. Sem a autorização não conseguimos falar com vocês por e-mail.\";\n    ok.push(cons);\n  }\n  const tudo = ok.every(Boolean);\n  if (!tudo){ const primeiro = form.querySelector(`[data-step=\"${n}\"] [aria-invalid=\"true\"]`); if (primeiro) primeiro.focus(); }\n  return tudo;\n}\nform.addEventListener(\"input\", e => { const f = e.target.closest(\".field.bad\"); if (f){ f.classList.remove(\"bad\"); const er = f.querySelector(\".err\"); if (er) er.textContent = \"\"; } });\nform.addEventListener(\"change\", e => {\n  if (e.target.name === \"dias\") $(\"#err-dias\").textContent = \"\";\n  if (e.target.name === \"frequencia\") $(\"#err-freq\").textContent = \"\";\n});\n\n/* ---------- etapas ---------- */\nfunction dados(){\n  const fd = new FormData(form);\n  const t = k => String(fd.get(k) || \"\").trim();\n  return {\n    nome: t(\"nome\"),\n    nascimento: t(\"nascimento\"),\n    genero: t(\"genero\"),\n    homegame: t(\"homegame\"),\n    instagram: arroba(t(\"instagram\")),\n    representante: t(\"representante\"),\n    email: t(\"email\").toLowerCase(),\n    celular: \"+55\" + so(t(\"celular\")),\n    endereco: t(\"endereco\"),\n    cep: so(t(\"cep\")),\n    cidade: t(\"cidade\"),\n    uf: t(\"uf\"),\n    origem: t(\"origem\"),\n    dias: fd.getAll(\"dias\").join(\"; \"),\n    frequencia: t(\"frequencia\"),\n    buyin: Number(so(t(\"buyin\"))) || \"\",\n    arrecadacao: Number(so(t(\"arrecadacao\"))) || \"\",\n    jogadores: Number(so(t(\"jogadores\"))) || \"\",\n    motivo: t(\"motivo\"),\n    optinEmail: $(\"#optin\").checked,\n    aceiteTermos: $(\"#termos\").checked\n  };\n}\nfunction resumo(){\n  const d = dados();\n  const linhas = [\n    [\"Homegame\", d.homegame + (d.instagram ? \" · \" + d.instagram : \"\")], [\"Representante\", d.representante], [\"E-mail\", d.email],\n    [\"Cidade\", d.cidade + (d.uf ? \" / \" + d.uf : \"\")], [\"Celular\", mascaraCel(d.celular.slice(3))], [\"Inscrito por\", d.nome]\n  ];\n  const dl = $(\"#review\"); dl.replaceChildren();\n  linhas.forEach(([k,v]) => { const w = document.createElement(\"div\"); const dt = document.createElement(\"dt\"); dt.textContent = k; const dd = document.createElement(\"dd\"); dd.textContent = v || \"—\"; w.append(dt, dd); dl.append(w); });\n}\nfunction vaiPara(n){\n  etapa = n;\n  form.querySelectorAll(\".pane\").forEach(p => p.hidden = +p.dataset.step !== n);\n  [...$(\"#steps\").children].forEach((li, i) => { li.classList.toggle(\"on\", i + 1 === n); li.classList.toggle(\"done\", i + 1 < n); });\n  $(\"#voltar\").hidden = n === 1;\n  $(\"#avancar\").textContent = n === 3 ? \"Enviar inscrição\" : \"Continuar\";\n  $(\"#formerr\").textContent = \"\";\n  if (n === 3) resumo();\n  const alvo = form.querySelector(`[data-step=\"${n}\"] input, [data-step=\"${n}\"] select`);\n  $(\"#steps\").scrollIntoView({ behavior: matchMedia(\"(prefers-reduced-motion: reduce)\").matches ? \"auto\" : \"smooth\", block: \"start\" });\n  if (alvo) setTimeout(() => alvo.focus({ preventScroll: true }), 50);\n}\n$(\"#voltar\").addEventListener(\"click\", () => vaiPara(etapa - 1));\n\nform.addEventListener(\"submit\", async e => {\n  e.preventDefault();\n  if (!valida(etapa)) return;\n  if (etapa < 3) return vaiPara(etapa + 1);\n  await enviar();\n});\n\n/* ---------- envio ---------- */\nasync function enviar(){\n  const btn = $(\"#avancar\");\n  btn.disabled = true; btn.textContent = \"Enviando…\";\n  const registro = { ...dados(), createdAt: new Date().toISOString(), status: \"novo\" };\n  try {\n    if (WEBHOOK_URL){\n      /* Envio \"simples\" (formulário comum, sem pedir resposta): o n8n abre esta página isolada\n         e o navegador bloqueia qualquer outro tipo de envio para fora dela */\n      await fetch(WEBHOOK_URL, { method: \"POST\", mode: \"no-cors\", body: new URLSearchParams({ dados: JSON.stringify(registro) }) });\n    }\n    sucesso(registro);\n  } catch (err) {\n    $(\"#formerr\").textContent = \"Não deu para enviar agora. Confira sua conexão e tente de novo em alguns segundos.\";\n  } finally {\n    btn.disabled = false; btn.textContent = \"Enviar inscrição\";\n  }\n}\nfunction sucesso(r){\n  form.hidden = true; $(\"#steps\").hidden = true; $(\"#lede\").hidden = true; $(\"#titulo\").hidden = true;\n  $(\"#sucesso\").hidden = false;\n  $(\"#iniciais2\").textContent = iniciais(r.homegame);\n  $(\"#hgOk\").textContent = r.homegame;\n  $(\"#emailOk\").textContent = r.email;\n}\n$(\"#novo\").addEventListener(\"click\", () => {\n  form.reset(); form.hidden = false; $(\"#steps\").hidden = false; $(\"#lede\").hidden = false; $(\"#titulo\").hidden = false;\n  $(\"#sucesso\").hidden = true; $(\"#iniciais\").textContent = \"H2\"; $(\"#motivoConta\").textContent = \"0 / 1000\"; vaiPara(1);\n});\n$(\"#linkPolitica\").addEventListener(\"click\", e => { e.preventDefault(); $(\"#err-consent\").textContent = \"O link da Política de Privacidade entra aqui quando o jurídico enviar.\"; });\n</script>\n</body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "b6f7d0c2-1a11-4c2e-9a01-000000000003",
      "name": "Mostrar formulário",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cadastro-h2-enviar",
        "responseMode": "onReceived",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "b6f7d0c2-1a11-4c2e-9a01-000000000004",
      "name": "Receber cadastro",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "webhookId": "0d2f3c1e-7f6a-4f0e-8a51-5f2b7d9e4c10"
    },
    {
      "parameters": {
        "jsCode": "// Pega o cadastro enviado pelo formulário e deixa só os campos da planilha\nreturn $input.all().map(item => {\n  // O formulário manda tudo num campo \"dados\" (texto em JSON)\n  const corpo = item.json.body || {};\n  let b = corpo;\n  try { if (typeof corpo.dados === 'string') b = JSON.parse(corpo.dados); else if (typeof corpo === 'string') b = JSON.parse(corpo); } catch (e) { b = {}; }\n  return { json: {\n    createdAt: b.createdAt || new Date().toISOString(),\n    nome: String(b.nome || '').trim(),\n    nascimento: b.nascimento || '',\n    genero: b.genero || '',\n    homegame: String(b.homegame || '').trim(),\n    instagram: b.instagram || '',\n    representante: String(b.representante || '').trim(),\n    email: String(b.email || '').trim().toLowerCase(),\n    celular: b.celular || '',\n    endereco: b.endereco || '',\n    cep: b.cep || '',\n    cidade: b.cidade || '',\n    uf: b.uf || '',\n    origem: b.origem || '',\n    dias: b.dias || '',\n    frequencia: b.frequencia || '',\n    buyin: b.buyin || '',\n    arrecadacao: b.arrecadacao || '',\n    jogadores: b.jogadores || '',\n    motivo: b.motivo || '',\n    optinEmail: b.optinEmail === true,\n    aceiteTermos: b.aceiteTermos === true\n    // status e emailEnviadoEm ficam de fora: num e-mail repetido, a planilha mantém o que já tinha\n  }};\n}).filter(i => i.json.email);"
      },
